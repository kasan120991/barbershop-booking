{
  "name": "@francis/shared",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared API contract — zod schemas, types, socket events, and pure helpers",
  "exports": {
    ".": "./src/index.ts",
    "./money": "./src/money.ts",
    "./phone": "./src/phone.ts",
    "./privacy": "./src/privacy.ts",
