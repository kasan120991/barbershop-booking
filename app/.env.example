# Copy to .env. NEVER commit .env — it is gitignored.

# The Express API. Must match APP_ORIGIN's counterpart in server/.env, because the
# API's CORS allowlist is exact and credentials are sent with every request.
NUXT_PUBLIC_API_BASE=http://localhost:4000/api

# PrimeVue 5 Community licence key — free for this shop, but REQUIRED.
# Register at https://primeui.dev/licenses/community
# Without a key PrimeVue may render a licence notice, which must never appear on the
# customer-facing kiosk. Eligibility needs re-confirming annually.
NUXT_PUBLIC_PRIMEUI_LICENSE=
