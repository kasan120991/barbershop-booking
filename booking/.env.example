# Copy to .env. NEVER commit .env — it is gitignored.

# The Express API. Must match BOOKING_ORIGIN's counterpart in server/.env, because the
# API's CORS allowlist is exact.
NUXT_PUBLIC_API_BASE=http://localhost:4000/api

# PrimeVue 5 Community licence key — free for this shop, but REQUIRED.
# Register at https://primeui.dev/licenses/community
# Without a key PrimeVue may render a licence notice. On the staff app that would be
# embarrassing; on the page a customer books from it is unacceptable.
NUXT_PUBLIC_PRIMEUI_LICENSE=
