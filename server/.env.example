# Copy to .env and fill in. NEVER commit .env — it is gitignored.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Force the Node process to UTC.
#
# MAMP's MySQL runs in the machine's local timezone (EDT here), not UTC. Every
# instant this app stores must be UTC regardless, so we pin the process timezone
# rather than reconfiguring MAMP — other projects share that MySQL instance and
# changing its global time_zone would affect them.
TZ=UTC

# Local MySQL provided by MAMP. Port 8889 is the MAMP default; root/root are its
# default credentials. Create the `francis_cutz` database in phpMyAdmin if missing.
DATABASE_URL="mysql://root:root@127.0.0.1:8889/francis_cutz"

# Exact origins — used for the CORS allowlist and, later, cookie scope.
APP_ORIGIN=http://localhost:3000
BOOKING_ORIGIN=http://localhost:3001

# --- Added in later phases, listed here so the shape is known ---
# SESSION_SECRET=
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
