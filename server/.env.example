# Copy to .env and fill in. NEVER commit .env — it is gitignored.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=debug

# Force the Node process to UTC.
#
# MAMP's MySQL runs in the machine's local timezone (EDT here), not UTC. Every
# instant this app stores must be UTC regardless, so we pin the process timezone
# rather than reconfiguring MAMP — other projects share that MySQL instance and
# changing its global time_zone would affect them.
TZ=UTC

# Local MySQL provided by MAMP. Port 8889 is the MAMP default; root/root are its
# default credentials. Create the `francis_cutz` database in phpMyAdmin if missing.
DATABASE_URL="mysql://root:root@127.0.0.1:8889/francis_cutz"

# Exact origins — used for the CORS allowlist and, later, cookie scope.
APP_ORIGIN=http://localhost:3000

# The origin customer-facing links are BUILT from — the payment QR code above all.
# `localhost` works until someone scans the QR with a phone, where it resolves to the
# phone itself. On a real shop network set this to the machine's LAN address.
BOOKING_ORIGIN=http://localhost:3001

# Optional. Extra origins allowed to call the API, comma-separated — the same apps
# reached at a different address. Still an exact allowlist; no wildcards.
# EXTRA_ORIGINS=http://localhost:3001,http://192.168.1.175:3000

# Staff sessions are absolute, not sliding — 12 hours covers a shift, so a device
# left on the counter stops being a way in by the next morning.
SESSION_TTL_HOURS=12

# IP throttle in front of the per-account lockout on the login route.
LOGIN_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15

# No SESSION_SECRET is needed: session cookies are not signed. The value is a 256-bit
# random token checked against a hash in the database, so a forged cookie simply fails
# lookup and a signing key would protect nothing extra.

# Stripe platform secret key.
#
# OPTIONAL. Leave it unset and the server still boots and the whole suite still passes —
# only the payment paths fail, with an error naming this variable. That is deliberate:
# nobody should need a Stripe account to work on the queue or the calendar.
#
# Use a SANDBOX key. Boot refuses an `sk_live_` key unless NODE_ENV=production, because a
# live key in a dev shell takes real money from a real barber's account against a seeded
# database.
#
# Get one with `stripe sandbox create` (Stripe CLI). Note that the `rkcs_test_` key it
# hands back for an *unclaimed* sandbox is restricted and CANNOT create Connect accounts
# — claim the sandbox (`stripe sandbox claim`) to get a full key.
# STRIPE_SECRET_KEY=sk_test_...

# Signing secret for the webhook endpoint at POST /api/stripe/webhook.
#
# OPTIONAL, but unset does NOT mean "skip verification" — it means the endpoint refuses
# every delivery. An unverified webhook is an unauthenticated POST that moves money.
#
# Locally: run `stripe listen --forward-to localhost:4000/api/stripe/webhook`, which
# prints a fresh whsec_ per session. Deployed: the Dashboard endpoint's own secret.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Publishable key, for the Payment Element on the customer's checkout page.
#
# NOT a secret — it ships to every browser. It lives here rather than in booking/.env
# because the checkout endpoint hands it to the client alongside the connected account
# id it must be initialised against, so the key and the secret key it has to match stay
# in one file. Two copies in two apps is one that can drift, and the symptom is a
# checkout page that mounts and then rejects every card.
# STRIPE_PUBLISHABLE_KEY=pk_test_...
