{
  "name": "@francis/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Francis Cutz API \u2014 Express 5, Prisma, MySQL, Socket.IO, Stripe",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:demo": "LOG_LEVEL=info tsx prisma/demo.ts",
    "db:studio": "prisma studio",
    "db:test:setup": "DATABASE_URL=mysql://root:root@127.0.0.1:8889/francis_cutz_test prisma migrate deploy",
    "vapi:provision": "tsx scripts/provision-vapi.ts"
  },
  "dependencies": {
    "@francis/shared": "workspace:*",
    "@node-rs/argon2": "2.0.2",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "helmet": "8.3.0",
    "luxon": "3.7.2",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "socket.io": "^4.8.3",
    "stripe": "^22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/luxon": "3.7.4",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "@vapi-ai/server-sdk": "^1.2.0",
    "pino-pretty": "13.1.3",
    "prisma": "7.9.1",
    "socket.io-client": "^4.8.3",
    "supertest": "7.2.2",
    "tsup": "8.5.1",
    "tsx": "4.23.11",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
